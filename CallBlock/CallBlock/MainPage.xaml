<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CallBlock.MainPage">
    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Label
                Text="This app sends all incoming calls from unsaved numbers directly to voicemail. You can flip the switch below to turn it off when you need to."
                SemanticProperties.HeadingLevel="Level1"/>
            <Switch x:Name="Switch" Toggled="Switch_OnToggled"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
